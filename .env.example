# Database
DATABASE_URL=
DATABASE_PUBLIC_URL=
USE_PUBLIC_URL=false

# Backup
RUN_MODE=railway
DUMP_FORMAT=dump
FILENAME_PREFIX=backup
BACKUP_PREFIX=postgres-backups/
MAX_BACKUPS=7
KEEP_LOCAL_BACKUP=false

# S3-compatible storage
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=
S3_REGION=us-east-1

# Compression
BACKUP_PASSWORD=

# Daemon scheduling (UTC)
BACKUP_TIME=00:00