# ==========================================
# PostgreSQL Database Configuration
# ==========================================

# PostgreSQL connection URL (private/internal)
# Example: postgresql://user:password@localhost:5432/database
DATABASE_URL=

# Optional: Public PostgreSQL connection URL
# Useful when connecting from outside your hosting provider
DATABASE_PUBLIC_URL=

# Use the public database URL instead of the private URL
# Default: false
USE_PUBLIC_URL=false


# ==========================================
# Backup Configuration
# ==========================================

# Execution mode:
# railway = Run once (for external schedulers such as Railway Cron)
# daemon  = Run continuously with internal daily scheduling
# cli     = Run once when executed manually
RUN_MODE=railway

# PostgreSQL dump format:
# dump = Custom PostgreSQL archive (recommended)
# sql  = Plain SQL file
# tar  = PostgreSQL tar archive
# Also supports: plain, custom
DUMP_FORMAT=dump

# Prefix for generated backup filenames
# Example: backup_20261117_120000_000000.dump.gz
FILENAME_PREFIX=backup

# Storage folder/prefix for uploaded backups
# Must end with /
BACKUP_PREFIX=postgres-backups/

# Maximum number of managed backups to retain
# Must be at least 1
MAX_BACKUPS=7

# Keep local backup files after successful upload
# false = Delete local file after successful upload
# true  = Keep local backup
KEEP_LOCAL_BACKUP=false


# ==========================================
# S3-Compatible Storage Configuration
# ==========================================

# S3-compatible endpoint URL
# Example: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Storage bucket name
R2_BUCKET_NAME=

# Access credentials
R2_ACCESS_KEY=
R2_SECRET_KEY=

# S3 region (Cloudflare R2 uses us-east-1 or auto)
S3_REGION=us-east-1


# ==========================================
# Compression & Encryption
# ==========================================

# Optional password for encrypted 7z backups
# Empty = gzip compression without encryption
# Set   = 7z compression with password protection
BACKUP_PASSWORD=
TIMEZONE=Asia/Kuala_Lumpur


# ==========================================
# Daemon Scheduling
# ==========================================

# Only applies when RUN_MODE=daemon
# Backup runs once daily at the configured time

# Backup time in 24-hour HH:MM format
# Default: 00:00 (midnight)
BACKUP_TIME=00:00

# Optional timezone for daemon scheduling
# Default: UTC (when omitted)
# Uses IANA timezone names supported by pytz
#
# Examples:
# UTC
# Asia/Kuala_Lumpur
# Asia/Singapore
# Asia/Tokyo
# Asia/Kolkata
# Europe/London
# America/New_York
# Australia/Sydney
# Note:
# TIMEZONE only affects internal daemon scheduling.
# Railway Cron, Linux cron, and Windows Task Scheduler
# use their own scheduling timezone settings.
# Backup filenames always use UTC timestamps.